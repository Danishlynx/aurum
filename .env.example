# Copy to .env.local for development. Never commit .env.local.
# Production values live in Vercel project settings.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Perfect Corp YouCam API (create at https://yce.perfectcorp.com/api-console/en/api-keys/)
# The console issues a key and a secret. Settled against the live API on
# 2026-09-02: the key alone authenticates, sent as "Authorization: Bearer <key>".
# The RSA token exchange at /s2s/v1.0/client/auth that the secret is for is real
# and works, but buys nothing, so no code reads PERFECTCORP_API_SECRET. Leave it
# blank unless a future endpoint asks for it. The evidence is written up in
# src/lib/server/providers/perfectcorp/endpoints.ts (PERFECTCORP_AUTH).
PERFECTCORP_API_KEY=
PERFECTCORP_API_SECRET=
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com
# With "true", the client will call an endpoint whose path or payload has not
# been verified against the live docs. Only the hair color try on is in that
# state today (src/lib/server/providers/perfectcorp/endpoints.ts), so leaving
# this unset is what makes /hair offer colors and refuse to render them rather
# than spend a credit on a guessed path. Set it only while reading the real
# request shape from the API playground, then record the finding and unset it.
PERFECTCORP_ALLOW_UNVERIFIED=

# SerpApi
SERPAPI_API_KEY=
SERPAPI_DEFAULT_GL=in
SERPAPI_DEFAULT_HL=en

# Anthropic
ANTHROPIC_API_KEY=
# Only needed when the key is an identity linked key (the console says so and
# the API answers 400 asking for it). Settings, Workspaces, copy the id.
ANTHROPIC_WORKSPACE_ID=

# Judge mode
# Generate the hash with: node scripts/hash-code.js "your-code"
JUDGE_ACCESS_CODE_HASH=
# The same hash, base64 encoded, and read in preference to the plain one above.
# Why it exists: a bcrypt hash starts "$2b$10$", and dotenv expansion substitutes
# every dollar segment it finds in a value in this file, so a hash pasted into
# .env.local can reach the server with those segments eaten and read as a code
# that never matches. The encoded form has no dollar in it and arrives whole.
# Encode with:
#   node -e "process.stdout.write(Buffer.from(process.argv[1]).toString('base64'))" "<hash>"
# On Vercel the values are real environment variables, so either one works and
# this can stay empty.
JUDGE_ACCESS_CODE_HASH_B64=
JUDGE_CREDITS_CAP=120
# How many live readings a judge session may run. Zero is a real setting and the
# one this build ships with: judges walk the whole flow and every screen renders
# from the saved demo profile, the capture screen opens disabled with the line
# from docs/01-user-flow.md, and POST /api/captures and the analyze route answer
# 429 with the same words. It exists because the Perfect Corp trial units are
# reserved for one founder run rather than spent by judging.
JUDGE_ANALYSES_ALLOWED=0
# SerpApi searches one judge session may spend over its whole life. This is a
# separate allowance from JUDGE_CREDITS_CAP on purpose: a Perfect Corp unit and a
# SerpApi search are two currencies from two companies, JUDGE_CREDITS_CAP is
# sized in units (one capture set alone is 58 of them), and while they shared one
# counter the analyses spent the budget and every routine step on the report
# ended as "No listing found near you yet". One session that grounds everything
# needs the routine (up to 7 steps), the makeup shades, the looks gaps, one
# nearby store lookup, and one broader retry where a strict query found nothing.
JUDGE_SERPAPI_SEARCHES=40

# Development and test switch for judge sessions with no database. With "true",
# POST /api/judge/session mints a session held in this process's memory instead
# of a judge_sessions row, so the judge cookie, the caps, the consent write, and
# every screen can be walked on a clean clone with no Supabase project. The
# access code is still checked against JUDGE_ACCESS_CODE_HASH first, so this is
# not a way in without the code. Like AURUM_DEMO_FIXTURE it must never be true in
# production, and unlike it, NODE_ENV production refuses the switch outright:
# sessions in one process's memory are wrong on a serverless deployment whatever
# the environment says. playwright.config.ts sets it for the judge specs.
JUDGE_FIXTURE_SESSION=

# Public (inlined into the client bundle, so never put a secret here)
# The landing page secondary link. The link is disabled until this is set.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Operations
PROVIDER_CALLS_ENABLED=true
DAILY_CAP_PERFECTCORP_UNITS=40
# Per owner, per UTC day. One owner grounding a whole report can spend around 20
# searches on its first pass, so 30 stopped a single session halfway. Set this
# from the SerpApi plan quota that is actually left; the code default is 120.
DAILY_CAP_SERPAPI_SEARCHES=120

# Development fixture switch. With "true", /report, /color, /makeup, /hair,
# /wardrobe, /looks, and /profile are served from the checked in fixtures in
# src/lib/server/profile/ (demo-fixture.ts, demo-fixture-wardrobe.ts, and
# demo-fixture-looks.ts) and touch no database and no provider, which is how
# those screens are built, screenshotted, and end to end tested before Supabase
# exists. The fixture is read only: POST /api/profile/undertone,
# POST /api/profile/hair/save, POST /api/garments, PATCH and DELETE on a
# garment, POST /api/looks/[id]/save, PATCH /api/profile, and
# POST /api/profile/delete all answer 403 rather than pretending to save, and
# POST /api/renders answers 503 rather than showing a try on nothing rendered.
# GET /api/profile/download answers 403 as well, because the demo profile is
# nobody's data to take a copy of (docs/06-safety-privacy.md, "Keys, sessions,
# abuse"). Leave it unset everywhere else: it must never be true in production.
AURUM_DEMO_FIXTURE=

# Reported by /api/health so a deploy can be identified. Optional, and read in
# this order (src/lib/server/env.ts, buildSha): AURUM_BUILD_SHA, then
# VERCEL_GIT_COMMIT_SHA which Vercel sets, then GITHUB_SHA which Actions sets.
# A local server has none of the three and reports "unknown".
AURUM_BUILD_SHA=

# Where the Next.js build writes its output (next.config.ts). Unset means
# ".next", which is what every ordinary run and every deploy uses. It exists for
# one case: npm run e2e starts a second development server beside the first with
# a different judge configuration, and two servers sharing one .next directory
# would write over each other's compiled routes, so playwright.config.ts points
# that second server at ".next/e2e-judge". Nothing in production sets it.
AURUM_DIST_DIR=

# Opts the three suites that spend real money into running: the live listing
# check in eval:grounding, the model judged rubric in eval:synthesis, and the
# live classifier injection check in eval:safety. All three are skipped without
# it even when the key they need is set, because eval:smoke gates every pull
# request and a key sitting in a shell must never make a gate spend money or
# fail. The test runner also takes fetch away from every suite
# (vitest.setup.ts); opting in puts it back for those suites and nowhere else.
# Leave it unset. Set it for one command when you mean to spend.
AURUM_LIVE_EVALS=

# Reserved for docs/07-payments-and-judge-mode.md. No code reads it yet.
BILLING_ENABLED=false
