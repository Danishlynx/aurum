# Copy to .env.local for development. Never commit .env.local.
# Production values live in Vercel project settings.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Perfect Corp YouCam API (create at https://yce.perfectcorp.com/api-console/en/api-keys/)
PERFECTCORP_API_KEY=
PERFECTCORP_BASE_URL=
# With "true", the client will call an endpoint whose path or payload has not
# been verified against the live docs. Only the hair color try on is in that
# state today (src/lib/server/providers/perfectcorp/endpoints.ts), so leaving
# this unset is what makes /hair offer colors and refuse to render them rather
# than spend a credit on a guessed path. Set it only while reading the real
# request shape from the API playground, then record the finding and unset it.
PERFECTCORP_ALLOW_UNVERIFIED=

# SerpApi
SERPAPI_API_KEY=
SERPAPI_DEFAULT_GL=in
SERPAPI_DEFAULT_HL=en

# Anthropic
ANTHROPIC_API_KEY=

# Judge mode
# Generate the hash with: node scripts/hash-code.js "your-code"
JUDGE_ACCESS_CODE_HASH=
JUDGE_CREDITS_CAP=120
JUDGE_ANALYSES_ALLOWED=3

# Public (inlined into the client bundle, so never put a secret here)
# The landing page secondary link. The link is disabled until this is set.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Operations
PROVIDER_CALLS_ENABLED=true
DAILY_CAP_PERFECTCORP_UNITS=40
DAILY_CAP_SERPAPI_SEARCHES=30

# Development fixture switch. With "true", /report, /color, /makeup, and /hair
# are served from the checked in fixture in src/lib/server/profile/demo-fixture.ts
# and touch no database and no provider, which is how those screens are built,
# screenshotted, and end to end tested before Supabase exists. The fixture is
# read only: POST /api/profile/undertone and POST /api/profile/hair/save answer
# 403 rather than pretending to save, and POST /api/renders answers 503 rather
# than showing a try on nothing rendered. Leave it unset everywhere else: it
# must never be true in production.
AURUM_DEMO_FIXTURE=

# Reported by /api/health so a deploy can be identified. Optional: on Vercel
# VERCEL_GIT_COMMIT_SHA is used, and a local server reports "unknown".
AURUM_BUILD_SHA=

# Reserved for docs/07-payments-and-judge-mode.md. No code reads it yet.
BILLING_ENABLED=false
