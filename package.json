{
  "name": "aurum",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "eval:capture": "vitest run evals/capture",
    "eval:consistency": "vitest run evals/consistency",
    "eval:palette": "vitest run evals/palette",
    "eval:synthesis": "vitest run evals/synthesis",
    "eval:grounding": "vitest run evals/grounding",
    "eval:stylist": "vitest run evals/stylist",
    "eval:budget": "vitest run evals/budget",
    "eval:safety": "vitest run evals/safety",
    "eval:smoke": "vitest run evals/capture evals/palette evals/grounding evals/budget evals/safety",
    "db:migrate": "node scripts/supabase-cli.mjs db push",
    "db:types": "node scripts/supabase-cli.mjs gen types typescript --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/plugin-kit": "^0.7.2",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
